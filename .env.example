# Переменные окружения бота. Значения — НЕ в этом файле и не в git.
# Либо сам секрет (локальный запуск), либо путь к файлу с ним (*_FILE, на сервере).

BOT_TOKEN=            # токен Telegram-бота от @BotFather          (или BOT_TOKEN_FILE=/path/to/bot.token)
PROXYAPI_KEY=         # ключ ProxyAPI — «мировые» модели            (или PROXYAPI_KEY_FILE=...)
GIGACHAT_AUTH_KEY=    # Authorization Key GigaChat API (Сбер)       (или GIGACHAT_AUTH_KEY_FILE=...)
YANDEX_API_KEY=       # API-ключ сервисного аккаунта Yandex Cloud   (или YANDEX_API_KEY_FILE=...)
YANDEX_FOLDER_ID=     # ID каталога Yandex Cloud                    (или YANDEX_FOLDER_ID_FILE=...)
ARENA_ADMINS=         # Telegram id без дневного лимита, через запятую (необязательно)
