# Переменные контейнера (на сервере — /opt/model-arena-bot/docker/arena.env).
# Сами ключи — файлами в /opt/model-arena-bot/secrets, в контейнере они видны как /run/secrets.
BOT_TOKEN_FILE=/run/secrets/bot.token
PROXYAPI_KEY_FILE=/run/secrets/proxyapi.key
GIGACHAT_AUTH_KEY_FILE=/run/secrets/gigachat-auth.key
YANDEX_API_KEY_FILE=/run/secrets/yandex-api.key
YANDEX_FOLDER_ID_FILE=/run/secrets/yandex-folder.id
# Better Stack (Logtail): токен источника — файлом, адрес (Ingesting host) — не секрет
BETTERSTACK_SOURCE_TOKEN_FILE=/run/secrets/betterstack-source.token
BETTERSTACK_HOST=
# Telegram id владельцев без дневного лимита, через запятую
ARENA_ADMINS=
